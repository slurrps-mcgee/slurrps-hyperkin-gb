#!/bin/sh
#
# cart-event: keeps /media/cart in step with the cartridge reader, so
# cartridges can be inserted and removed while the console is on.
#
#   cart-event add|change|remove DEV    from udev (90-retronsq-cart.rules)
#   cart-event reconcile                from sq-session (boot, fallback)
#
# Whatever the event, it reconciles: it looks at what the reader has *now*
# and makes the mount match. That covers readers that reconnect on a swap
# (remove + add) and readers that stay connected and only report a media
# change (udev "change" with DISK_MEDIA_CHANGE=1, thanks to the media
# polling the udev rule enables). A medium change always remounts, so a
# stale mount of the previous cartridge can't survive a swap.
#
# On a change it bumps $RUN_DIR/cart-generation (libsqcart uses it to notice
# a swap during a copy) and runs CartInserted / CartRemoved from common.sh
# in the background, so udev isn't held up. A swap seen in one event (old
# medium out, new one in) is "swapped": CartInserted with the removal's
# effects, so RetroArch is stopped only once. Mounting is read-only, and the
# reader's block device is set read-only first (hdparm -r1): nothing can
# ever write to a cartridge.
#
. "${SQ_LIB:-${SQ_ROOT:-}/usr/lib/retronsq}/common.sh"

PORT="$R/sys/bus/usb/devices/3-1"
GEN_FILE="$RUN_DIR/cart-generation"

# The reader's disk ("sda") when the reader is on its USB port
ReaderDisk(){
	local d
	for d in "$PORT"/3-1:1.1/host*/target*/*/block/sd*; do
		[ -e "$d" ] && { echo "${d##*/}"; return; }
	done
}

# What to mount for a disk: its first partition if it has one, else itself
MediumDevice(){
	local p
	for p in "$R/sys/class/block/$1/$1"[0-9]*; do
		[ -e "$p" ] && { echo "${p##*/}"; return; }
	done
	echo "$1"
}

# Size in sectors; 0 when the device is gone or has no medium
BlockSize(){
	cat "$R/sys/class/block/$1/size" 2> /dev/null || echo 0
}

# The device mounted at /media/cart ("sda1"), if any
MountedDevice(){
	awk -v dir="$READER_DIR" '$2 == dir { n = split($1, p, "/"); d = p[n] } END { print d }' \
		"$R/proc/mounts" 2> /dev/null
}

# Reconcile [force]: make /media/cart match the reader. "force" remounts
# even if the same device is still there (a media change).
Reconcile(){
	local disk want="" have removed=0 inserted=0 event
	disk=$(ReaderDisk)
	if [ -n "$disk" ] && [ "$(BlockSize "$disk")" -gt 0 ]; then
		want=$(MediumDevice "$disk")
	fi
	have=$(MountedDevice)

	# Drop a mount that is stale (device gone or emptied), points at
	# another device, or whose medium just changed. Lazy, so a program
	# still holding a file can't keep it mounted.
	if [ -n "$have" ]; then
		if [ "$1" = force ] || [ "$have" != "$want" ] || [ "$(BlockSize "$have")" -le 0 ]; then
			umount -l "$READER_DIR"
			have=""
			removed=1
		fi
	fi

	if [ -n "$want" ] && [ -z "$have" ]; then
		hdparm -r1 "/dev/$disk" > /dev/null 2>&1
		mkdir -p "$READER_DIR"
		if mount -t vfat -o ro,noexec,nodev,noatime "/dev/$want" "$READER_DIR"; then
			inserted=1
		else
			LogSD "cartridge: couldn't mount /dev/$want"
		fi
	fi

	case $removed$inserted in
		00) return 0 ;;
		01) event=inserted ;;
		10) event=removed ;;
		11) event=swapped ;;
	esac
	echo $(($(cat "$GEN_FILE" 2> /dev/null || echo 0) + 1)) > "$GEN_FILE"
	setsid "$LIB_DIR/cart-event" notify-$event < /dev/null > /dev/null 2>&1 &
}

case "$1" in
	notify-inserted) CartInserted; exit 0 ;;
	notify-removed) CartRemoved; exit 0 ;;
	notify-swapped) CartInserted swapped; exit 0 ;;
esac

# One reconcile at a time: an insert fires several udev events at once
exec 9> "$RUN_DIR/cart-event.lock"
flock 9

Log "cart-event $* (media change: ${DISK_MEDIA_CHANGE:-0})"
if [ "$1" = change ] && [ "$DISK_MEDIA_CHANGE" = 1 ]; then
	Reconcile force
else
	Reconcile
fi
