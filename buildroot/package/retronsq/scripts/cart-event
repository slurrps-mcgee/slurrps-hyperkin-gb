#!/bin/sh
#
# cart-event: keeps /media/cart in step with the cartridge reader, so
# cartridges can be inserted and removed while the console is on.
#
#   cart-event add|change|remove DEV    from udev (90-retronsq-cart.rules)
#   cart-event reconcile                from sq-session (boot, fallback)
#   cart-event write-enable|write-disable
#                                       from Cartridge Tools, around its
#                                       "Write a save to the cartridge"
#
# Whatever the event, it reconciles: it looks at what the reader has *now*
# and makes the mount match. That covers readers that reconnect on a swap
# (remove + add) and readers that stay connected and only report a media
# change (udev "change" with DISK_MEDIA_CHANGE=1, thanks to the media
# polling the udev rule enables). A medium change always remounts, so a
# stale mount of the previous cartridge can't survive a swap.
#
# On a change it bumps $RUN_DIR/cart-generation (libsqcart uses it to notice
# a swap during a copy) and runs CartInserted / CartRemoved from common.sh
# in the background, so udev isn't held up. A swap seen in one event (old
# medium out, new one in) is "swapped": CartInserted with the removal's
# effects, so RetroArch is stopped only once. Mounting is read-only, and the
# reader's block device is set read-only first (hdparm -r1): nothing can
# write to a cartridge, except between write-enable and write-disable,
# which Cartridge Tools runs around the one write the user asked for.
#
# Before locking a newly attached drive, its read-only flag is recorded in
# $RUN_DIR/reader-wp: the kernel sets it when the device itself reports
# write protection, i.e. the reader won't take writes at all.
#
. "${SQ_LIB:-${SQ_ROOT:-}/usr/lib/retronsq}/common.sh"

PORT="$R/sys/bus/usb/devices/3-1"
GEN_FILE="$RUN_DIR/cart-generation"
WP_FILE="$RUN_DIR/reader-wp"          # "0"/"1": the drive's own write protection
WP_DISK="$RUN_DIR/reader-wp.disk"     # the drive it was read from

# The reader's disk ("sda") when the reader is on its USB port
ReaderDisk(){
	local d
	for d in "$PORT"/3-1:1.1/host*/target*/*/block/sd*; do
		[ -e "$d" ] && { echo "${d##*/}"; return; }
	done
}

# What to mount for a disk: its first partition if it has one, else itself
MediumDevice(){
	local p
	for p in "$R/sys/class/block/$1/$1"[0-9]*; do
		[ -e "$p" ] && { echo "${p##*/}"; return; }
	done
	echo "$1"
}

# Size in sectors; 0 when the device is gone or has no medium
BlockSize(){
	cat "$R/sys/class/block/$1/size" 2> /dev/null || echo 0
}

# The device mounted at /media/cart ("sda1"), if any
MountedDevice(){
	awk -v dir="$READER_DIR" '$2 == dir { n = split($1, p, "/"); d = p[n] } END { print d }' \
		"$R/proc/mounts" 2> /dev/null
}

# SetReadOnly 0|1 DISK [DEVICE]: the kernel's read-only flag on the disk
# and, if the cartridge is mounted from a partition, on that too (on this
# kernel the flag is per block device)
SetReadOnly(){
	hdparm -r$1 "/dev/$2" > /dev/null 2>&1
	[ -n "$3" ] && [ "$3" != "$2" ] && hdparm -r$1 "/dev/$3" > /dev/null 2>&1
	return 0
}

# Mount DEVICE read-only at /media/cart
MountReadOnly(){
	mount -t vfat -o ro,noexec,nodev,noatime "/dev/$1" "$READER_DIR"
}

# LogReaderInfo DISK: what the reader is, for working out what else it can
# do (writing saves, programming blank cartridges): its USB identity, every
# USB interface it has (only the mass-storage one is used), and its drive.
# Once per attached drive, like RecordWriteProtect.
LogReaderInfo(){
	local f i line
	line="cartridge reader:"
	for f in idVendor idProduct bcdDevice manufacturer product speed bNumInterfaces; do
		line="$line $f=$(cat "$PORT/$f" 2> /dev/null | tr -d '\n')"
	done
	LogSD "$line"
	for i in "$PORT"/3-1:*; do
		[ -d "$i" ] || continue
		line="  interface ${i##*/}:"
		for f in bInterfaceClass bInterfaceSubClass bInterfaceProtocol bNumEndpoints interface; do
			line="$line $f=$(cat "$i/$f" 2> /dev/null | tr -d '\n')"
		done
		line="$line driver=$(basename "$(readlink "$i/driver" 2> /dev/null)" 2> /dev/null)"
		for f in "$i"/ep_*; do
			[ -d "$f" ] && line="$line ${f##*/}:$(cat "$f/type" 2> /dev/null)/$(cat "$f/direction" 2> /dev/null)"
		done
		LogSD "$line"
	done
	line="  drive $1:"
	for f in device/vendor device/model device/rev removable size; do
		line="$line ${f#device/}=$(cat "$R/sys/class/block/$1/$f" 2> /dev/null | tr -d '\n' | tr -s ' ')"
	done
	LogSD "$line"
}

# RecordWriteProtect DISK: note whether the drive reports write protection.
# Only before this script first locks it (hdparm -r1 sets the same flag):
# once per attached drive.
RecordWriteProtect(){
	[ "$(cat "$WP_DISK" 2> /dev/null)" = "$1" ] && return
	LogReaderInfo "$1"
	cat "$R/sys/class/block/$1/ro" > "$WP_FILE" 2> /dev/null || rm -f "$WP_FILE"
	echo "$1" > "$WP_DISK"
	LogSD "cartridge: reader write protection: $(cat "$WP_FILE" 2> /dev/null || echo unknown)"
}

# WriteEnable: open the mounted cartridge for writing (block device and
# mount). Refused when there is no cartridge or the reader is write
# protected.
WriteEnable(){
	local disk have
	disk=$(ReaderDisk)
	have=$(MountedDevice)
	if [ -z "$disk" ] || [ -z "$have" ]; then
		LogSD "cartridge: no mounted cartridge to open for writing"
		return 1
	fi
	if [ "$(cat "$WP_FILE" 2> /dev/null)" = 1 ]; then
		LogSD "cartridge: the reader is write protected, not opening it"
		return 1
	fi
	SetReadOnly 0 "$disk" "$have"
	if ! mount -o remount,rw,noexec,nodev,noatime "$READER_DIR"; then
		SetReadOnly 1 "$disk" "$have"
		LogSD "cartridge: couldn't remount /dev/$have for writing"
		return 1
	fi
	LogSD "cartridge: opened /dev/$have for writing"
}

# WriteDisable: back to read-only, whatever happened. If the mount can't
# be switched back, it is replaced by a fresh read-only one (same device,
# so no insert or remove is reported).
WriteDisable(){
	local disk have
	disk=$(ReaderDisk)
	have=$(MountedDevice)
	sync
	if [ -n "$have" ] && ! mount -o remount,ro "$READER_DIR"; then
		umount -l "$READER_DIR"
		[ -n "$disk" ] && SetReadOnly 1 "$disk" "$have"
		MountReadOnly "$have" || LogSD "cartridge: couldn't mount /dev/$have read-only again"
	fi
	[ -n "$disk" ] && SetReadOnly 1 "$disk" "$have"
	LogSD "cartridge: read-only again"
}

# Reconcile [force]: make /media/cart match the reader. "force" remounts
# even if the same device is still there (a media change).
Reconcile(){
	local disk want="" have removed=0 inserted=0 event
	disk=$(ReaderDisk)
	if [ -n "$disk" ] && [ "$(BlockSize "$disk")" -gt 0 ]; then
		want=$(MediumDevice "$disk")
	fi
	have=$(MountedDevice)

	# Drop a mount that is stale (device gone or emptied), points at
	# another device, or whose medium just changed. Lazy, so a program
	# still holding a file can't keep it mounted.
	if [ -n "$have" ]; then
		if [ "$1" = force ] || [ "$have" != "$want" ] || [ "$(BlockSize "$have")" -le 0 ]; then
			umount -l "$READER_DIR"
			have=""
			removed=1
		fi
	fi

	# The reader is gone: forget its write protection
	if [ -z "$disk" ]; then
		rm -f "$WP_FILE" "$WP_DISK"
	fi

	if [ -n "$want" ] && [ -z "$have" ]; then
		RecordWriteProtect "$disk"
		SetReadOnly 1 "$disk" "$want"
		mkdir -p "$READER_DIR"
		if MountReadOnly "$want"; then
			inserted=1
		else
			LogSD "cartridge: couldn't mount /dev/$want"
		fi
	fi

	case $removed$inserted in
		00) return 0 ;;
		01) event=inserted ;;
		10) event=removed ;;
		11) event=swapped ;;
	esac
	echo $(($(cat "$GEN_FILE" 2> /dev/null || echo 0) + 1)) > "$GEN_FILE"
	setsid "$LIB_DIR/cart-event" notify-$event < /dev/null > /dev/null 2>&1 &
}

case "$1" in
	notify-inserted) CartInserted; exit 0 ;;
	notify-removed) CartRemoved; exit 0 ;;
	notify-swapped) CartInserted swapped; exit 0 ;;
esac

# One reconcile at a time: an insert fires several udev events at once
exec 9> "$RUN_DIR/cart-event.lock"
flock 9

Log "cart-event $* (media change: ${DISK_MEDIA_CHANGE:-0})"
case "$1" in
	write-enable) WriteEnable; exit ;;
	write-disable) WriteDisable; exit ;;
esac
if [ "$1" = change ] && [ "$DISK_MEDIA_CHANGE" = 1 ]; then
	Reconcile force
else
	Reconcile
fi
